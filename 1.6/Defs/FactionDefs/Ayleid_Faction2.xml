<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Nenalata</defName>
        <label>Kingdom of Nenalata</label>
        <description>The last Ayleid city in Cyrodiil, sitting on the eastern shore of Niben Bay long after the White-Gold Tower fell. House Dynar rules it with a tired kind of practicality. These elves have stopped pretending the old days are coming back, and they can usually be reasoned with. The older Flower Courts call them traitors for that.</description>
        <colorSpectrum>
            <li>(0.5, 0.65, 0.8)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Ayleid</pawnSingular>
        <pawnsPlural>Ayleids</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.2</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>King of Nenalata</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
        <techLevel>Medieval</techLevel>
        <fixedName>Kingdom of Nenalata</fixedName>
        <allowedCultures>
            <li>ESCP_Culture_Ayleid</li>
        </allowedCultures>

        <royalTitleTags>
            <li>ESCP_Title_Ayleid</li>
        </royalTitleTags>
        <royalFavorLabel>Nenalata's Favor</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>

        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Star-Rite</ideoName>
        <ideoDescription>Nenalata keeps the older Ayleid faith in the four elements and in the Light behind the stars, with few of the bargains the Daedric courts made. It has become a religion of careful upkeep: wells are tended, sky charts are corrected, and the city's children learn the hymns of cities that no longer exist.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Magnus</name><type>whose flight tore open the stars</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityMagnus</iconPath>
            </li>
            <li>
                <nameType><name>Meridia</name><type>lady of infinite energies and of the sworn sword</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityMeridia</iconPath>
            </li>
            <li>
                <nameType><name>Molag Bal</name><type>king of domination, patron of cruel courts</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityMolagBal</iconPath>
            </li>
            <li>
                <nameType><name>Dagon</name><type>lord of destruction</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Auri-El</name><type>the old king of the elven gods</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityAuriEl</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li>ESCP_Style_Ayleid</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_FlowerCourts</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Ayleid_Child</li>
                    <li>ESCP_Backstory_Ayleid_Citizen</li>
                    <li>ESCP_Backstory_Ayleid_Military</li>
                    <li>ESCP_Backstory_Ayleid_Mage</li>
                </categories>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_Ayleid_Trader</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>ESCP_Caravan_Ayleid_Trader</li>
        </visitorTraderKinds>
        <baseTraderKinds>
            <li>ESCP_Caravan_Ayleid_Trader</li>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-25~50</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Ayleid_Melee>10</ESCP_Pawnkind_Ayleid_Melee>
                    <ESCP_Pawnkind_Ayleid_Ranged>7</ESCP_Pawnkind_Ayleid_Ranged>
                    <ESCP_Pawnkind_Ayleid_Mage>4</ESCP_Pawnkind_Ayleid_Mage>
                    <ESCP_Pawnkind_Ayleid_Captain>3</ESCP_Pawnkind_Ayleid_Captain>
                    <ESCP_Pawnkind_Ayleid_Elite>2</ESCP_Pawnkind_Ayleid_Elite>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Ayleid_Citizen>15</ESCP_Pawnkind_Ayleid_Citizen>
                    <ESCP_Pawnkind_Ayleid_Merchant>6</ESCP_Pawnkind_Ayleid_Merchant>
                    <ESCP_Pawnkind_Ayleid_Noble>4</ESCP_Pawnkind_Ayleid_Noble>
                    <ESCP_Pawnkind_Ayleid_Mage>3</ESCP_Pawnkind_Ayleid_Mage>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Ayleid_Trader>1</ESCP_Pawnkind_Ayleid_Trader>
                    <ESCP_Pawnkind_Ayleid_Quartermaster>1</ESCP_Pawnkind_Ayleid_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Ayleid_Melee>8</ESCP_Pawnkind_Ayleid_Melee>
                    <ESCP_Pawnkind_Ayleid_Ranged>5</ESCP_Pawnkind_Ayleid_Ranged>
                    <ESCP_Pawnkind_Ayleid_Elite>1</ESCP_Pawnkind_Ayleid_Elite>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Ayleid_Citizen>8</ESCP_Pawnkind_Ayleid_Citizen>
                    <ESCP_Pawnkind_Ayleid_Melee>10</ESCP_Pawnkind_Ayleid_Melee>
                    <ESCP_Pawnkind_Ayleid_Ranged>8</ESCP_Pawnkind_Ayleid_Ranged>
                    <ESCP_Pawnkind_Ayleid_Mage>4</ESCP_Pawnkind_Ayleid_Mage>
                    <ESCP_Pawnkind_Ayleid_Elite>2</ESCP_Pawnkind_Ayleid_Elite>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Kingdom of Nenalata</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li MayRequire="Rick.ESCP.Ayleids">ESCP_Faction_Ayleid_Flower_Kings</li>
                </hostileFactionDefs>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_Nenalata</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_Nenalata</li>
                </rankTracks>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Nenalata</li>
                    <li>Bisnensel</li>
                    <li>Beldaburo</li>
                    <li>Nenyond Twyll</li>
                    <li>Wendelbek</li>
                    <li>Lindai</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>TemperateForest</li>
                    <li>TemperateSwamp</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
