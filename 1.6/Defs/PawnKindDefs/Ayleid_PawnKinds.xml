        <defaultFactionDef>ESCP_Faction_Ayleid_Flower_Kings</defaultFactionDef>
        <xenotypeSet>
            <xenotypeChances>
                <ESCP_Xenotype_Ayleid MayRequire="Ludeon.RimWorld.Biotech">1</ESCP_Xenotype_Ayleid>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <maxGenerationAge>65</maxGenerationAge>
        <chemicalAddictionChance>0</chemicalAddictionChance>
